{
  "name": "onova-za-imotite",
  "private": true,
  "type": "module",
  "description": "Онова за имотите: search imot.bg, import every listing it finds, and browse them as a filterable list and a map (EN/BG).",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "lint": "eslint",
    "knip": "knip",
    "check": "prettier --check .",
    "format": "prettier --write . && eslint --fix",
    "gazetteer": "node scripts/build-gazetteer.mjs",
    "districts": "node scripts/build-districts.mjs",
    "ci:preflight": "node scripts/ci-preflight.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@convex-dev/rate-limiter": "0.4.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "convex": "^1.46.0",
    "leaflet": "^1.9.4",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260610-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@tanstack/eslint-config": "0.4.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.60",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
